#setup : 모듈 로드, pygame 초기화, 변수작성

import pygame, sys, random
from pygame.locals import *
pygame.init()
pygame.display.set_caption("rain")
screen = pygame.display.set_mode((1000,600))
clock = pygame.time.Clock()
raindrop_spawn_time = 0
mike_umbrella_image = pygame.image.load(r"C:\Users\nana6\Desktop\pythonfiles\images\Mike_umbrella.png").convert()  #이미지 그래픽카드가 읽을수있는 포멧으로
image_cloud = pygame.image.load(r"C:\Users\nana6\desktop\pythonfiles\images\cloud.png").convert()

# 클래스 : 객체 제어
class Raindrop:
    def __init__(self, x, y):
        self.x = x
        self.y = y

    def move(self):
        self.y += 7

    def draw(self):
        pygame.draw.line(screen, (0,0,0), (self.x, self.y),(self.x, self.y+5),1)

    def off_screen(self):                                # 빗방울 지우기            
        return self.y > 800

class Mike:
    def __init__(self):
        self.x = 300
        self.y = 400
    def draw(self):
        screen.blit(mike_umbrella_image,(self.x, self.y))
    def hit_by(self, raindrop):
        return pygame.Rect(self.x, self.y, 170, 192).collidepoint(raindrop.x, raindrop.y) 

class Cloud:
    def __init__(self):
        self.x = 300
        self.y = 50
    def draw(self):
        screen.blit(image_cloud, (self.x, self.y))
    def rain(self):
        raindrops.append(Raindrop(random.randint(self.x, self.x+300), self.y+100))
    def move(self):
        if pressed_keys[K_RIGHT]:
            self.x += 1
        if pressed_keys[K_LEFT]:
            self.x -= 1

# 리스트 : 객체 움직임들을 기록

raindrops = []
mike = Mike()
cloud = Cloud()

# 게임루프 : 실제 게임 실행
"""
for루프 빗방울 삭제시 오류발생-리스트 항목을 하나하나 확인
 for raindrop in raindrops:
        raindrop.move()
        raindrop.draw()
    pygame.display.update()   
"""
"""
빗방울 __init()__ 아무 위치 지정후
구름 클래서 안에 함수를 만들어 빗방울을 만들고 빗방울 위취도 정해 -> 빗방울 클래스에 전달
"""
while 1:
    clock.tick(60)
    for event in pygame.event.get():
        if event.type == QUIT:
            sys.exit()
    pressed_keys = pygame.key.get_pressed()

    # raindrops.append(Raindrop())
    screen.fill((255,255,255))
    mike.draw()
    cloud.draw()
    cloud.rain()
    cloud.move()

    i = 0
    while i < len(raindrops):
        raindrops[i].move()
        raindrops[i].draw()

        if raindrops[i].off_screen() or mike.hit_by(raindrops[i]): 
            del raindrops[i]
            i -= 1
        i += 1
    
    pygame.display.update()
    
